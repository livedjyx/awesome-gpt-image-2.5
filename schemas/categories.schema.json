{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "slug"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^C\\d{2}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z]+(?:-[a-z]+)*$"
      }
    }
  }
}
